    <JFXTextArea fx:id="JTA_dst" editable="false" prefHeight="150.0" AnchorPane.bottomAnchor="20.0" AnchorPane.leftAnchor="40.0" AnchorPane.rightAnchor="40.0" AnchorPane.topAnchor="310.0"/>
