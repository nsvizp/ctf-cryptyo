  <Label fx:id="JLB_title" alignment="CENTER" prefHeight="70.0" text="Custom Base" AnchorPane.leftAnchor="10.0" AnchorPane.rightAnchor="10.0" AnchorPane.topAnchor="10.0"><font><Font name="Arial" size="40.0"/></font></Label>
  <AnchorPane fx:id="ACP_controllerAnchorPane" AnchorPane.bottomAnchor="10.0" AnchorPane.leftAnchor="10.0" AnchorPane.rightAnchor="10.0" AnchorPane.topAnchor="80.0">
